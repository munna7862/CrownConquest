; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crown & Conquest"
config/description="Celtic Kings + Age of Empires inspired RTS with RPG hero mechanics, individual unit progression, and authoritative deterministic simulation."
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="CrownConquest.Presentation"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
